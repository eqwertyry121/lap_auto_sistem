# --- Цикл мониторинга ---
# Интервал опроса KP Search API (секунды)
POLL_INTERVAL_SEC=45
# Сколько первых страниц свежей выдачи класть в durable queue за один цикл.
# 2 снижает риск пропуска лотов при долгой обработке первой страницы.
LIVE_SEARCH_PAGES=2
# Файл SQLite-базы (SSOT живого цикла)
DB_PATH=data/kp_bot.db
# Daily SQLite backups created with VACUUM INTO.
DB_BACKUP_DIR=data/backups
# Пауза между запросами деталей объявлений /eds/{id} (мс)
FETCH_DELAY_MS=700

# --- Gemini ---
GEMINI_API_KEY=
# Старые модели (напр. gemini-2.5-flash) могут быть недоступны новым ключам.
# Список рабочих для вашего ключа: go run ./cmd/models
GEMINI_MODEL=gemini-2.5-flash-lite
# Дешёвая модель для простого извлечения характеристик из текста/фото.
# Если нужна эскалация качества, можно отдельно поднять VISION/SEARCH.
GEMINI_LITE_MODEL=gemini-2.5-flash-lite
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
GEMINI_SEARCH_MODEL=gemini-2.5-flash-lite
# Максимум параллельных вызовов Gemini
GEMINI_CONCURRENCY=5
# Дневной лимит вызовов Gemini. 0 = явно без лимита.
GEMINI_DAILY_LIMIT=80
# Оценочный дневной бюджет Gemini в USD. 0 = без денежного лимита.
GEMINI_DAILY_BUDGET_USD=0

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CSV-экспорт рыночной базы (без ключей и внешних API) ---
CSV_PATH=data/market_history.csv
EXPORT_INTERVAL_MIN=30

# --- Датасет рынка (research.db) ---
RESEARCH_DB_PATH=data/research.db

# --- Воронка L0–L5 ---
# Подробная трассировка воронки в data/funnel_trace.log (0 = выключить)
FUNNEL_TRACE=1
# Период пересборки рыночной модели (минуты)
MARKET_REFRESH_MIN=360
# Дайджест в Telegram (HH:MM)
DIGEST_AT=09:00
# Heartbeat и singleton-lock живого бота.
HEARTBEAT_PATH=data/kpbot.heartbeat
LOCK_PATH=data/kpbot.lock
# Пауза при антибот-челлендже KP (минуты)
CHALLENGE_PAUSE_MIN=30
# Общий cooldown между bot/research после KP 429/challenge.
KP_COOLDOWN_PATH=data/kp_cooldown
KP_RATE_COOLDOWN_SEC=90
KP_CHALLENGE_COOLDOWN_MIN=30
# 1 = watchdog также перезапускает research.exe; по умолчанию следит только за kpbot.exe
KP_WATCHDOG_RESEARCH=0

# --- Интернет ---
# Интернет используется ТОЛЬКО чтобы узнать, ЧТО за ноутбук (L3.4 модель→железо),
# а НЕ для цен. Цены берём ТОЛЬКО из наших данных KP (медианы dGPU-пула).
# 0 = выключить интернет-определение железа
WEB_RESEARCH=1
# Алерт «нужно посмотреть» по нераспознанным лотам — только от этой цены (EUR)
MANUAL_MIN_EUR=400
# ЛОСЬ-сводка (редкое железо вне эталона, сравнить не с чем) — только от этой цены (EUR)
MOOSE_MIN_EUR=400

# --- Арбитраж ноутбуков с дискретной графикой ---
# Запрещённые линейки через запятую (бан по названию, мгновенный скип)
BANNED_MODELS=macbook
# 1 = брать только ноутбуки с дискретной видеокартой (без dGPU — тихий скип)
REQUIRE_DGPU=1
# «Рыночная цена» = отклонение не выше +N% от медианы (выше — тихо)
MARKET_TOL_PCT=5
# Порог «алмаза»: на сколько % ниже рынка должен быть лот
DIAMOND_DEV_PCT=-15
# Глубже этого отклонения — подозрение на приманку
SUSPECT_DEV_PCT=-40
# Минимальный размер опорной группы медианы
DIAMOND_MIN_N=5
